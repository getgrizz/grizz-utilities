# ── Grizz ─────────────────────────────────────────────────────────────────────
# Get your API key at https://getgrizz.com/dashboard
GRIZZ_API_KEY=your_grizz_api_key_here

# ── Salesforce ─────────────────────────────────────────────────────────────────
# Username and password for the Salesforce user running the integration
SALESFORCE_USERNAME=you@yourorg.com
SALESFORCE_PASSWORD=your_password_here

# Security token — reset at: Setup > My Personal Information > Reset My Security Token
SALESFORCE_SECURITY_TOKEN=your_security_token_here

# Use 'login' for production, 'test' for sandbox
SALESFORCE_DOMAIN=login

# ── HubSpot ────────────────────────────────────────────────────────────────────
# Private App token — create one at: Settings > Integrations > Private Apps
HUBSPOT_API_KEY=your_private_app_token_here

# ── Attio ──────────────────────────────────────────────────────────────────────
# API key — create at: Attio > Workspace settings > Developers > API keys.
# Headless: Grizz maps fields server-side and never holds this key.
ATTIO_API_KEY=your_attio_api_key_here
